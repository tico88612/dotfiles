{{- $enableIterm2 := get . "enableIterm2" | default false }}
{{- $enableSSH := get . "enableSSH" | default false }}
{{- if not $enableSSH }}
.ssh
.ssh/**
.config/1Password/ssh
.config/1Password/ssh/**
{{- end }}
{{- if or (ne .chezmoi.os "darwin") (not $enableIterm2) }}
Library/Application Support/iTerm2
Library/Application Support/iTerm2/**
{{- end }}
{{- if ne .chezmoi.os "darwin" }}
.config/herdr
.config/herdr/**
.config/1Password
.config/1Password/**
{{- end }}

# Generated locally by the 1Password and uv CLIs.
.zsh-custom/plugins/1password-op
.zsh-custom/plugins/1password-op/**
.zsh-custom/plugins/uv
.zsh-custom/plugins/uv/**

# Compiled files and completions generated inside exact plugin directories.
.zsh-custom/**/*.zwc
.zsh-custom/plugins/zsh-nvm/_*
.zsh-custom/plugins/zsh-nvm/previous_version
